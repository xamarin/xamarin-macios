# CoreMIDI is not present on tvOS
!missing-pinvoke! MusicSequenceSetMIDIEndpoint is not bound
!missing-pinvoke! MusicTrackGetDestMIDIEndpoint is not bound
!missing-pinvoke! MusicTrackSetDestMIDIEndpoint is not bound

# the enum is available on tvOS, but none of its values are, so just don't bind the enum itself
!missing-enum! AUAudioMixRenderingStyle not bound
!missing-null-allowed! 'AudioUnit.AUInternalRenderBlock AudioUnit.AUAudioUnit::get_InternalRenderBlock()' is missing a '?' on return type block parameter #5
